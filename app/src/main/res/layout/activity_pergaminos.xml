<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0F0F14"
    android:gravity="center_horizontal"
    android:fitsSystemWindows="true"
    tools:context=".PergaminosActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📜 PERGAMINOS DE LA CIUDADELA"
        android:textColor="#FAB1A0"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp"/>

    <!-- Nombre del archivo -->
    <EditText
        android:id="@+id/etNombreArchivo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Nombre del pergamino (ej: cronica.txt)"
        android:textColor="#FFFFFF"
        android:textColorHint="#55555A"
        android:backgroundTint="#E17055"
        android:inputType="text"
        android:layout_marginBottom="16dp"/>

    <!-- Contenido del pergamino -->
    <EditText
        android:id="@+id/etContenido"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:hint="Escribe el informe aquí..."
        android:textColor="#FFFFFF"
        android:textColorHint="#55555A"
        android:backgroundTint="#E17055"
        android:gravity="top|left"
        android:inputType="textMultiLine"
        android:scrollbars="vertical"
        android:layout_marginBottom="24dp"/>

    <!-- Almacenamiento interno -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BÓVEDA PRIVADA (MEMORIA INTERNA)"
        android:textColor="#9E9E9E"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnGuardarInterno"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Guardar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#E17055"/>

        <Button
            android:id="@+id/btnLeerInterno"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Leer"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#34495E"/>
    </LinearLayout>

    <!-- Almacenamiento externo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MAPAS DE CAMPAÑA (MEMORIA EXTERNA)"
        android:textColor="#9E9E9E"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnGuardarExterno"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Guardar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#55E6C1"/>

        <Button
            android:id="@+id/btnLeerExterno"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Leer"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#34495E"/>
    </LinearLayout>

</LinearLayout>
